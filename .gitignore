# 套件（用 npm install 就能重新產生，不需要上傳）
node_modules

# 打包後的輸出
dist

# 環境變數（可能有金鑰，絕對不能上傳）
.env
.env.*
!.env.example

# 系統與編輯器產生的檔案
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
*.log

# Claude Code 個人設定（不上傳）
.claude/settings.local.json

# Python 資料腳本的 API 快取（可以重新產生）
scripts/.cache/
__pycache__/

# AI 動物通後端：Python 虛擬環境、可以重新產生的文件與向量資料庫
backend/.venv/
backend/data/
backend/index/
