{
  "regions": ["sin1"],
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "functions": {
    "api/*.py": {
      "maxDuration": 60,
      "excludeFiles": "{public/**,src/**,scripts/**,dist/**,node_modules/**,backend/.venv/**,backend/db/**,backend/data/vector_keys.json,backend/data/vectors.npy,backend/data/chunks.jsonl,backend/verify_*.py,backend/test_*.py,**/*.md,**/*.psd}"
    }
  }
}
