{
  "regions": ["sin1"],
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "functions": {
    "api/ask.py": {
      "maxDuration": 60,
      "excludeFiles": "{public/**,src/**,scripts/**,dist/**,node_modules/**,backend/.venv/**,backend/db/**,backend/data/vector_keys.json,**/*.md,**/*.psd}"
    }
  }
}
